<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter's template declares this only in the debug and profile
         manifests, so `flutter run` has network access and every release build
         silently has none: requests fail with a socket error rather than a
         permission error, which looks exactly like the server being down. It
         belongs here, in main, where all three build types inherit it. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Read before a request so an offline attempt fails immediately with an
         honest message instead of waiting out the timeout. Without this,
         connectivity_plus reports "no connection" on Android and the app
         refuses to send anything at all. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Taking a dish photograph in the admin editor. Reading the gallery needs
         no permission: image_picker goes through the system photo picker, which
         hands back one file the user chose rather than granting library access. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <application
        android:label="practice"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required on Android 11+ for image_picker to find a camera app.
             Without it the camera button appears to do nothing. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
