<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Development APNs. A release build uses RunnerRelease.entitlements, which
	     says "production" — get this wrong in a TestFlight build and Apple
	     issues tokens the production APNs servers will not deliver to. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
